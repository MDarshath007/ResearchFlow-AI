# ============================================================
# ResearchFlow — CLIENT Environment Variables
# ============================================================
# Copy this file to .env and fill in your own values:
#   cp .env.example .env
#
# All variables prefixed with VITE_ are exposed to the
# browser bundle by Vite. Never put secrets here.
# ============================================================

# Base URL of the backend REST API (no trailing slash)
VITE_API_URL=http://localhost:5000/api

# Base URL of the backend server (for direct asset/upload URLs)
VITE_SERVER_URL=http://localhost:5000
