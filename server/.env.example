# ============================================================
# ResearchFlow — SERVER Environment Variables
# ============================================================
# Copy this file to .env and fill in your own values:
#   cp .env.example .env
#
# NEVER commit the real .env file — it is listed in .gitignore.
# ============================================================

# Port the Express server will listen on
PORT=5000

# MongoDB connection string (Atlas URI or local)
# Local example : mongodb://localhost:27017/researchflow
# Atlas example : mongodb+srv://<user>:<password>@cluster.mongodb.net/researchflow
MONGO_URI=your_mongodb_connection_string_here

# Secret key used to sign and verify JSON Web Tokens (min 32 random chars)
JWT_SECRET=your_jwt_secret_here

# Google Gemini API key — obtain from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model name to use for AI features
GEMINI_MODEL=gemini-2.0-flash

# Optional — GitHub personal access token to raise API rate limit
# for public repository analysis (leave blank if not needed)
GITHUB_TOKEN=
